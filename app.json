{
  "expo": {
    "name": "TaraGo",
    "slug": "tarago",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/tarago-icon.png",
    "scheme": "tarago",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/brand/tarago-icon.png",
      "bundleIdentifier": "com.anonymous.tarago",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "V6BDRRK4FQ",
      "buildNumber": "5"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/brand/tarago-adaptive.png",
        "monochromeImage": "./assets/brand/tarago-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.tarago",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand/tarago-mark.png",
          "imageWidth": 112
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "usePrecompiledModules": false
          },
          "android": {
            "extraMavenRepos": [
              "https://repository.map.naver.com/archive/maven"
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "주변 정류장과 지하철역을 찾기 위해 현재 위치를 사용합니다.",
          "locationAlwaysAndWhenInUsePermission": "설정한 정류소 근처에 도착하면 앱을 사용하지 않을 때도 버스 도착 시간을 알려드립니다.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "의견에 첨부할 사진을 선택합니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-naver-map",
      "./plugins/with-tarago-launch-screen"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9d8a0d3c-cae6-4394-8490-90a9cd6864ca"
      }
    },
    "owner": "kimkijun",
    "platforms": [
      "ios",
      "android"
    ]
  }
}
